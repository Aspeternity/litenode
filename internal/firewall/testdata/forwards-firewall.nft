#!/usr/sbin/nft -f
# Generated by LiteNode from /etc/litenode/state.json; do not edit.
table inet litenode
delete table inet litenode

table inet litenode {
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif "lo" accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, mld-listener-query } accept
		udp sport 67 udp dport 68 accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
		icmp type echo-request accept
		icmpv6 type echo-request accept
		tcp dport 22 accept comment "litenode:ssh"
	}
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		meta nfproto ipv4 meta l4proto { tcp, udp } th dport 30001 dnat ip to 203.0.113.10:443 comment "litenode:forward:5"
		meta nfproto ipv6 tcp dport 30002 dnat ip6 to [2001:db8::10]:443 comment "litenode:forward:6"
		meta nfproto ipv4 meta l4proto { tcp, udp } th dport 30003 dnat ip to 203.0.113.20:443 comment "litenode:forward:7"
		meta nfproto ipv6 meta l4proto { tcp, udp } th dport 30003 dnat ip6 to [2001:db8::20]:443 comment "litenode:forward:7"
		meta nfproto ipv4 udp dport 30004 dnat ip to 203.0.113.30:443 comment "litenode:forward:8"
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		meta l4proto { tcp, udp } ct original proto-dst 30001 ct status dnat masquerade comment "litenode:forward:5"
		meta l4proto tcp ct original proto-dst 30002 ct status dnat masquerade comment "litenode:forward:6"
		meta l4proto { tcp, udp } ct original proto-dst 30003 ct status dnat masquerade comment "litenode:forward:7"
		meta l4proto udp ct original proto-dst 30004 ct status dnat masquerade comment "litenode:forward:8"
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		meta l4proto { tcp, udp } ct original proto-dst 30001 ct status dnat accept comment "litenode:forward:5"
		meta l4proto tcp ct original proto-dst 30002 ct status dnat accept comment "litenode:forward:6"
		ip saddr { 198.51.100.7 } meta l4proto { tcp, udp } ct original proto-dst 30003 ct status dnat accept comment "litenode:forward:7"
		meta l4proto udp ct original proto-dst 30004 ct status dnat accept comment "litenode:forward:8"
	}
}
