#!/usr/sbin/nft -f
# Generated by LiteNode from /etc/litenode/state.json; do not edit.
table inet litenode
delete table inet litenode

table inet litenode {
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif "lo" accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, mld-listener-query } accept
		udp sport 67 udp dport 68 accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
		icmp type echo-request accept
		icmpv6 type echo-request accept
		tcp dport 22222 accept comment "litenode:ssh"
		ip saddr { 203.0.113.7, 198.51.100.0/24 } tcp dport 443 accept comment "litenode:node:3"
		ip6 saddr { 2001:db8::/32 } tcp dport 443 accept comment "litenode:node:3"
		meta l4proto { tcp, udp } th dport 30000-30010 accept comment "litenode:manual:9"
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
	}
}
